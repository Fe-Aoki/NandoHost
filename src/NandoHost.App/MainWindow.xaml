                </StackPanel></Border>
                <TextBlock Text="{loc:Translate Key=Text070}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,16,0,0"/>
              </StackPanel></ScrollViewer></Grid>
            </TabItem>
            <TabItem Header="{loc:Translate Key=Text071}">
              <ScrollViewer><StackPanel>
