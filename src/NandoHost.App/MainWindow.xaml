                  <TextBlock x:Name="BedrockLocalHint" Visibility="Collapsed" Text="{loc:Translate Key=Text080}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,12,0,0"/>
                </StackPanel></Border>
                                  <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
