                <UniformGrid Columns="2" Margin="0,0,-14,18">
                  <Border Style="{StaticResource Card}" Margin="0,0,14,0"><StackPanel><TextBlock Text="Calamity" FontFamily="{StaticResource TerrariaFont}" FontWeight="Bold" FontSize="24" Foreground="#F1CE95"/><TextBlock Text="{loc:Translate Key=Text058}" Foreground="{DynamicResource Muted}" Margin="0,8,0,12"/><TextBlock Text="{loc:Translate Key=Text059}" FontSize="12" Margin="0,0,0,18"/><Button x:Name="CreateCalamityButton" Content="{loc:Translate Key=Text060}" Style="{StaticResource Primary}" Tag="Calamity" Click="CreateModdedClick" HorizontalAlignment="Left"/></StackPanel></Border>
