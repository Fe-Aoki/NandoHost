<Window x:Class="NandoHost.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NandoHost" Icon="Assets/Icons/nandohost-red.ico" Style="{StaticResource {x:Type Window}}" Width="1280" Height="920" MinWidth="960" MinHeight="640" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border x:Name="WindowSurface" BorderThickness="0">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="#202126" MouseLeftButtonDown="TitleDrag">
        <Grid Margin="18,0,4,0">
          <TextBlock Text="NandoHost" FontSize="10" Foreground="#B8B5A9" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource Flat}" Content="—" Click="MinimizeClick" Padding="14,7" Background="Transparent" Margin="0" ToolTip="Minimizar"/>
            <Button Style="{StaticResource Flat}" x:Name="MaximizeButton" Content="□" Click="MaximizeClick" Padding="14,7" Background="Transparent" Margin="0" ToolTip="Maximizar"/>
            <Button Style="{StaticResource Flat}" Content="✕" Click="CloseClick" Padding="14,7" Background="Transparent" Margin="0" ToolTip="Fechar"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1" x:Name="GameWorkspace" ClipToBounds="True">
        <Grid.RenderTransform><TranslateTransform x:Name="GameSlide"/></Grid.RenderTransform>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="228"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="GameSidebar" Background="{DynamicResource SidebarSurface}" BorderBrush="{DynamicResource SidebarBorder}" BorderThickness="0,0,1,0">
          <Grid x:Name="SidebarContent" Margin="20,28,20,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><Image x:Name="GameBrandIcon" Source="{StaticResource MinecraftGameImage}" Width="36" Height="36" Margin="0,0,8,0" ToolTip="Minecraft" AutomationProperties.Name="Minecraft"/><TextBlock Text="NandoHost" FontFamily="Bahnschrift" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" TextOptions.TextFormattingMode="Display"/></StackPanel>
              <Button Style="{StaticResource Flat}" Content="← Escolher jogo" Click="HomeClick" Background="Transparent" Foreground="{DynamicResource Muted}" FontSize="11" Padding="0,4" Margin="0,4,0,18" HorizontalAlignment="Left"/>
            </StackPanel>
            <StackPanel Grid.Row="1">
              <Button x:Name="DashboardNav" Style="{StaticResource Nav}" Content="▣    Visão geral" Tag="0" Click="NavigateClick" Background="#3F4933"/>
              <Button x:Name="PacksNav" Style="{StaticResource Nav}" Content="▦    Modpacks" Tag="1" Click="NavigateClick"/>
              <Button x:Name="NetworkNav" Style="{StaticResource Nav}" Content="↗    Conexão externa" Tag="2" Click="NavigateClick"/>
              <Button x:Name="SettingsNav" Style="{StaticResource Nav}" Content="⚙    Configurações" Tag="3" Click="NavigateClick"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="4,32,0,12">
              <TextBlock Text="SEUS SERVIDORES" FontSize="10" Foreground="{DynamicResource Muted}"/>
              <TextBlock Text="Um servidor ligado por vez" FontSize="10" Foreground="#938D7E" Margin="0,7,0,0"/>
            </StackPanel>
            <ListBox Grid.Row="3" x:Name="ServerList" Background="Transparent" BorderThickness="0" VerticalAlignment="Top" SelectionChanged="ServerSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Width="18" Height="20" VerticalAlignment="Top" Margin="0,2,7,0"><Image.Style><Style TargetType="Image"><Setter Property="Source" Value="{StaticResource MinecraftGameImage}"/><Style.Triggers><DataTrigger Binding="{Binding IsTerraria}" Value="True"><Setter Property="Source" Value="{StaticResource TerrariaGameImage}"/></DataTrigger></Style.Triggers></Style></Image.Style></Image><StackPanel Grid.Column="1"><TextBlock ToolTip="{Binding Name}" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"><Run Text="{Binding EditionLabel, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding MinecraftVersion}"/></TextBlock></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="4">
              <Button x:Name="NewButton" Content="+  Novo servidor" Click="NewServerClick" Margin="0,12,0,18"/>
              <Border x:Name="SidebarNote" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Background="{StaticResource DirtBrush}" Padding="12" RenderOptions.EdgeMode="Aliased"><StackPanel><TextBlock x:Name="SidebarNoteTitle" Text="DESDE A PRIMEIRA CABANA." FontFamily="Bahnschrift" FontSize="10" Foreground="#D7D2BC"/><TextBlock Text="O mesmo espírito de explorar. Um novo jeito de hospedar." FontSize="11" Foreground="#C2B8A4" Margin="0,7,0,0"/></StackPanel></Border>
              <TextBlock Text="PRÉVIA 0.8.9  ·  WINDOWS" FontSize="9" Foreground="#938D7E" Margin="4,15,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border x:Name="GameTexture" Grid.Column="1" Background="{StaticResource DirtBrush}" Opacity="0.26" RenderOptions.EdgeMode="Aliased"/>
        <Grid x:Name="WorkspaceContent" Grid.Column="1" Margin="30,25,30,22">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid x:Name="PageHeader" Margin="0,0,0,20">
            <StackPanel><TextBlock x:Name="PageEyebrow" Text="PAINEL DO SERVIDOR" FontSize="10" Foreground="{DynamicResource Accent}"/><TextBlock x:Name="PageTitle" Text="Vamos criar seu mundo." FontFamily="{StaticResource MinecraftFont}" FontSize="28" FontWeight="Bold" Margin="0,12,140,10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" TextOptions.TextFormattingMode="Display"/><TextBlock x:Name="PageSubtitle" Text="Tudo o que você precisa para hospedar no seu PC." Foreground="{DynamicResource Muted}" FontSize="12"/></StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource PopupSurface}" BorderBrush="#515A42" BorderThickness="1" Padding="12,6"><TextBlock x:Name="EditionBadge" Text="JAVA EDITION" FontFamily="Bahnschrift" FontSize="11" Foreground="#C8D2B2"/></Border>
          </Grid>
          <TabControl Grid.Row="1" x:Name="Pages" SelectedIndex="0">
            <TabItem Header="Visão geral">
              <ScrollViewer x:Name="OverviewScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="ResponsiveSizeChanged"><Grid x:Name="OverviewContent">
                <Grid.RowDefinitions><RowDefinition x:Name="HeroRow" Height="190"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" ClipToBounds="True" SnapsToDevicePixels="True">
                  <Border Margin="1" Background="#151B12" ClipToBounds="True">
                  <Grid x:Name="BannerViewport" Background="{StaticResource LandscapeBrush}" ClipToBounds="True" SizeChanged="BannerViewportSizeChanged" SnapsToDevicePixels="True">
                    <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#B010150E" Offset="0"/><GradientStop Color="#9010150E" Offset="0.35"/><GradientStop Color="#1810150E" Offset="0.75"/><GradientStop Color="#0010150E" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                    <StackPanel x:Name="HeroContent" Margin="28,22,0,20" Width="420" HorizontalAlignment="Left" VerticalAlignment="Center">
                      <TextBlock x:Name="HeroEyebrow" Text="UMA NOVA AVENTURA. A MESMA ESSÊNCIA." FontFamily="Bahnschrift" FontSize="10" Foreground="#C8DBAC" Margin="0,0,0,10"/>
                      <TextBlock x:Name="HeroTitle" Style="{StaticResource BlockTitle}" FontSize="28" LineHeight="38"><Run Text="CADA MUNDO TEM"/><LineBreak/><Run Text="UMA HISTÓRIA."/></TextBlock>
                      <TextBlock x:Name="HeroCopy" Text="Reúna seus amigos. Continue sua Jornada!" FontSize="13" Foreground="#D5D8C6" Margin="0,12,0,0"/>
                    </StackPanel>
                  </Grid>
                  </Border>
                  <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" IsHitTestVisible="False" SnapsToDevicePixels="True"/>
                </Grid>
                <UniformGrid x:Name="MetricsCards" SizeChanged="ResponsiveSizeChanged" Grid.Row="2" Columns="3" Margin="0,0,-12,14">
                  <Border Style="{StaticResource Card}" Padding="15,12" Margin="0,0,12,0"><StackPanel><TextBlock Style="{StaticResource Caption}" Text="ESTADO DO SERVIDOR"/><TextBlock x:Name="StateText" Text="Desligado" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="StateDetail" Text="Pronto quando você estiver" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,7,0,0"/></StackPanel></Border>
                  <Border Style="{StaticResource Card}" Padding="15,12" Margin="0,0,12,0"><StackPanel><TextBlock Style="{StaticResource Caption}" Text="MEMÓRIA DO SERVIDOR"/><TextBlock x:Name="MemoryText" Text="— MB" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="MemoryDetail" Text="Uso real do processo Java" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,7,0,0"/></StackPanel></Border>
                  <Border Style="{StaticResource Card}" Padding="15,12" Margin="0,0,12,0"><StackPanel><TextBlock Style="{StaticResource Caption}" Text="PROCESSADOR"/><TextBlock x:Name="CpuText" Text="— %" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Percentual da CPU total" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,7,0,0"/></StackPanel></Border>
                </UniformGrid>
                <Grid x:Name="ActionRow" SizeChanged="ResponsiveSizeChanged" Grid.Row="1" Margin="0,12,0,14">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button x:Name="StartButton" Style="{StaticResource Primary}" Content="▶  LIGAR SERVIDOR" MinWidth="220" FontSize="17" Padding="24,14" Click="StartClick"/>
                  <WrapPanel x:Name="SecondaryActions" Grid.Column="1" HorizontalAlignment="Right">
                    <Button x:Name="StopButton" Content="■  Parar" Click="StopClick" IsEnabled="False"/>
                    <Button x:Name="BackupButton" Content="↧  Backup" Click="BackupClick"/>
                    <Button x:Name="FolderButton" Content="Abrir pasta" Click="FolderClick" Margin="0"/>
                    <Button Style="{StaticResource Flat}" x:Name="ForceButton" Content="Encerrar à força" Click="ForceClick" Foreground="#E6A28C" Background="Transparent" Visibility="Collapsed" Margin="8,0,0,0"/>
                  </WrapPanel>
                </Grid>
                <Border x:Name="ConsolePanel" MinHeight="230" Grid.Row="3" Background="{DynamicResource ConsoleSurface}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="0">
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="68"/></Grid.RowDefinitions>
                    <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="17,0"><Grid><TextBlock Text="CONSOLE AO VIVO" FontSize="10" Foreground="{DynamicResource ConsoleCaption}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><CheckBox x:Name="AutoScrollCheck" Content="Acompanhar" IsChecked="True" FontSize="11"/><Button Style="{StaticResource Flat}" Content="Limpar" Click="ClearConsoleClick" Padding="10,4" Background="Transparent" FontSize="11" Margin="12,0,0,0"/></StackPanel></Grid></Border>
                    <ListBox Grid.Row="1" x:Name="ConsoleList" Background="Transparent" BorderThickness="0" Padding="10" FontFamily="Cascadia Mono,Consolas" FontSize="12" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource ConsoleText}"/></DataTemplate></ListBox.ItemTemplate>
                      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="3,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
                    </ListBox>
                    <Grid Grid.Row="2" Margin="12,8,12,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="CommandBox" AutomationProperties.Name="Comando do servidor" ToolTip="Tab completa · Ctrl+Espaço mostra sugestões · ↑↓ histórico · Enter envia" TextChanged="CommandTextChanged" SelectionChanged="CommandSelectionChanged" LostKeyboardFocus="CommandLostFocus" MaxLength="512" IsEnabled="False"/><Button Grid.Column="1" x:Name="SendButton" Content="Enviar ↵" Padding="14,6" Click="SendClick" Margin="10,0,0,0" IsEnabled="False"/></Grid>
                    <Popup x:Name="CommandPopup" PlacementTarget="{Binding ElementName=CommandBox}" Placement="Top" StaysOpen="True" AllowsTransparency="True" PopupAnimation="None" Focusable="False" VerticalOffset="-5">
                      <Border x:Name="SuggestionsPanel" Background="#20241B" BorderBrush="#74825C" BorderThickness="1" Width="{Binding ActualWidth, ElementName=CommandBox}">
                        <StackPanel><TextBlock Text="Tab completa · ↑↓ escolhem · Enter envia · Esc fecha" FontSize="10" Foreground="#A9B991" Margin="12,9,12,7"/>
                          <ListBox x:Name="SuggestionList" MaxHeight="210" Background="Transparent" BorderThickness="0" PreviewMouseLeftButtonUp="SuggestionClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" FontFamily="Consolas" Foreground="#D7E4C3" TextWrapping="NoWrap"/><TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="10,0,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate>
                          </ListBox>
                        </StackPanel>
                      </Border>
                    </Popup>
                  </Grid>
                </Border>
              </Grid></ScrollViewer>
            </TabItem>
            <TabItem Header="Modpacks">
              <Grid><ScrollViewer x:Name="MinecraftPacksPanel">
                <StackPanel>
                  <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Um novo mundo, com seus mods." FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Instalação automática de pacotes Vanilla/Fabric. Forge, NeoForge e Quilt serão identificados e bloqueados nesta prévia. Cada importação cria um novo perfil Java. Add-ons Bedrock não são instalados aqui." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,9,0,16"/><WrapPanel><Button x:Name="ImportMrButton" Content="Importar .mrpack" Style="{StaticResource Primary}" Click="ImportMrClick"/><Button x:Name="ImportCfButton" Content="Importar Server Pack .zip" Click="ImportCurseClick"/><Button Style="{StaticResource Flat}" Content="Abrir CurseForge ↗" Click="CurseWebsiteClick" Background="Transparent"/></WrapPanel></StackPanel></Border>
                  <TextBlock Text="EXPLORAR MODRINTH" Style="{StaticResource Caption}"/>
                  <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="PackQuery" AutomationProperties.Name="Pesquisar modpack" ToolTip="Nome do modpack" KeyDown="SearchKeyDown"/><Button Grid.Column="1" x:Name="SearchButton" Content="Buscar" Click="SearchClick" Margin="10,0,0,0"/></Grid>
                  <Grid Height="200"><ListBox x:Name="PackResults"  Background="{DynamicResource SidebarSurface}" BorderBrush="#4A4D40" SelectionChanged="PackSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,3"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding Description}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel x:Name="PackEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" IsHitTestVisible="False"><TextBlock x:Name="PackEmptyTitle" Text="Encontre seu próximo modpack" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="PackEmptyDetail" Text="Digite um nome acima e clique em Buscar." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center"/></StackPanel></Grid>
                  <TextBlock Text="Versão do modpack" Style="{StaticResource Caption}" Margin="0,14,0,8"/><Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="PackVersions" ToolTip="Selecione a versão do modpack"/><Button Grid.Column="1" x:Name="InstallPackButton" Content="Instalar versão" Click="InstallPackClick" Margin="10,0,0,0" IsEnabled="False" Style="{StaticResource Primary}"/></Grid>
                  <TextBlock Text="Arquivos são verificados quando há hashes. Isso confirma integridade, não a segurança do código dos mods. Seus amigos precisam do pacote compatível no jogo deles." Foreground="{DynamicResource Muted}" FontSize="12"/>
                </StackPanel>
              </ScrollViewer>

              <ScrollViewer x:Name="TerrariaModsPanel" Visibility="Collapsed"><StackPanel>
                <TextBlock Text="Escolha sua próxima aventura" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="Cada opção cria um novo perfil, com mundo e mods próprios. Seus servidores Vanilla continuam disponíveis na lista." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,18"/>
                <UniformGrid Columns="2" Margin="0,0,-14,18">
                  <Border Style="{StaticResource Card}" Margin="0,0,14,0"><StackPanel><TextBlock Text="Calamity" FontFamily="{StaticResource TerrariaFont}" FontWeight="Bold" FontSize="24" Foreground="#F1CE95"/><TextBlock Text="Um mundo para enfrentar o impossível." Foreground="{DynamicResource Muted}" Margin="0,8,0,12"/><TextBlock Text="tModLoader + Calamity Mod + Calamity Mod Music. Importe os dois .tmod e as dependências da versão escolhida." FontSize="12" Margin="0,0,0,18"/><Button x:Name="CreateCalamityButton" Content="Criar perfil Calamity" Style="{StaticResource Primary}" Tag="Calamity" Click="CreateModdedClick" HorizontalAlignment="Left"/></StackPanel></Border>
                  <Border Style="{StaticResource Card}" Margin="0,0,14,0"><StackPanel><TextBlock Text="Seus próprios mods" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Monte o seu jeito de jogar." Foreground="{DynamicResource Muted}" Margin="0,8,0,12"/><TextBlock Text="Servidor tModLoader com arquivos .tmod locais. Você escolhe o conjunto de mods e a configuração do mundo." FontSize="12" Margin="0,0,0,18"/><Button x:Name="CreateCustomButton" Content="Criar perfil personalizado" Tag="Custom" Click="CreateModdedClick" HorizontalAlignment="Left"/></StackPanel></Border>
                </UniformGrid>
                <Border Style="{StaticResource Card}"><StackPanel>
                  <TextBlock x:Name="TerrariaModsHeading" Text="MODS DESTE PERFIL" FontWeight="SemiBold" FontSize="16"/>
                  <TextBlock x:Name="TerrariaModsHelp" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,14"/>
                  <WrapPanel Margin="0,0,0,14"><Button x:Name="ImportTmodsButton" Content="+ Importar .tmod" Style="{StaticResource Primary}" Click="ImportTmodsClick"/><Button x:Name="RemoveTmodButton" Content="Remover selecionado" Click="RemoveTmodClick"/><Button Content="Calamity na Workshop ↗" Style="{StaticResource Flat}" Background="Transparent" Click="CalamityWorkshopClick"/></WrapPanel>
                  <ListBox x:Name="TerrariaModsList" MinHeight="90" MaxHeight="180" AutomationProperties.Name="Mods importados neste servidor" SelectionChanged="TerrariaModSelected"/>
                  <TextBlock x:Name="TerrariaModsStatus" Foreground="{DynamicResource Accent}" FontSize="12" Margin="0,10,0,0"/>
                </StackPanel></Border>
                <TextBlock Text="No tModLoader, use Abrir pasta de mods e selecione os arquivos .tmod aqui. Para mods da Workshop, procure em steamapps/workshop/content/1281930. Importe também as dependências. Os jogadores precisam de tModLoader e mods compatíveis. Mods executam código neste PC; use fontes de confiança." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,16,0,0"/>
              </StackPanel></ScrollViewer></Grid>
            </TabItem>
            <TabItem Header="Conexão">
              <ScrollViewer><StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="1. Teste no próprio computador" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Use estes endereços neste PC quando o servidor estiver ligado. Para seus amigos, configure um endereço externo." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,9,0,14"/>
                  <Grid x:Name="LocalJavaPanel"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="JAVA · ENDEREÇO E PORTA JUNTOS" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="LocalAddress" Text="localhost:25565" FontFamily="Consolas" FontSize="23" Foreground="{DynamicResource Accent}" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="Copiar Java" Click="CopyLocalClick" VerticalAlignment="Center"/></Grid>
                  <StackPanel x:Name="LocalBedrockPanel" Visibility="Collapsed" Margin="0,12,0,0"><TextBlock x:Name="LocalNativeCaption" Text="BEDROCK · PREENCHA ENDEREÇO E PORTA SEPARADAMENTE" FontSize="10" Foreground="{DynamicResource Muted}"/><Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="LocalBedrockAddress" Text="127.0.0.1 · porta 19132" FontFamily="Consolas" FontSize="20" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Copiar endereço" Click="CopyBedrockHostClick"/><Button Grid.Column="2" Content="Copiar porta" Click="CopyBedrockPortClick"/></Grid></StackPanel>
                  <TextBlock x:Name="BedrockLocalHint" Visibility="Collapsed" Text="Para jogar Bedrock no mesmo Windows, pode ser necessário habilitar loopback. O NandoHost não modifica firewall ou permissões do sistema automaticamente." Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,12,0,0"/>
                </StackPanel></Border>
                                  <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
                    <DockPanel><TextBlock Text="2. CONECTE PELA INTERNET" FontFamily="{StaticResource MinecraftFont}" FontSize="18" FontWeight="Bold"/><TextBlock Text="PROTÓTIPO · PLAYIT" Foreground="{DynamicResource Accent}" FontSize="10" HorizontalAlignment="Right"/></DockPanel>
                    <TextBlock x:Name="TunnelIntro" Text="Só quem hospeda precisa do agente. Confira as opções gratuitas disponíveis para sua edição." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,12,0,16"/>
                    <Border Background="#20241D" BorderBrush="#4F6140" BorderThickness="1" Padding="14"><StackPanel>
                      <TextBlock x:Name="TunnelStateText" Text="●  Agente parado" FontSize="17" Foreground="{DynamicResource Accent}"/>
                      <TextBlock x:Name="TunnelDetailText" Text="Baixe o agente oficial para começar. As opções disponíveis dependem da edição e do transporte." Foreground="{DynamicResource Muted}" Margin="0,7,0,0" FontSize="12"/>
                    </StackPanel></Border>
                    <WrapPanel Margin="0,14,0,6">
                      <Button x:Name="DownloadAgentButton" Content="1. Baixar agente" Click="DownloadAgentClick"/>
                      <Button x:Name="StartAgentButton" Content="2. Iniciar agente" Click="StartAgentClick" Style="{StaticResource Primary}"/>
                      <Button x:Name="StopAgentButton" Content="Parar agente" Click="StopAgentClick" IsEnabled="False"/>
                    </WrapPanel>
                    <WrapPanel>
                      <Button x:Name="ClaimAgentButton" Content="Vincular conta ↗" Click="ClaimAgentClick" IsEnabled="False"/>
                      <Button Content="Configurar túnel ↗" Click="TunnelDashboardClick"/>
                    </WrapPanel>
                    <TextBlock x:Name="TunnelTargetText" Text="No site: Minecraft Java → este agente → 127.0.0.1:25565." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,12,0,0"/>
                    <TextBlock x:Name="TunnelPlanText" Text="A criação inicial fica no site; o NandoHost não contrata planos. O agente continua ligado até você pará-lo ou fechar o aplicativo." Foreground="#C3B68B" FontSize="11" Margin="0,10,0,0"/>
                  </StackPanel></Border>
<Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="3. Compartilhe com seus amigos" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="O agente pode preencher este campo quando informar um destino compatível. Confira e salve o endereço do perfil. Salvar não verifica a entrada no servidor." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,10,0,12"/><TextBlock x:Name="PublicAddressLabel" Text="Endereço externo Java" Style="{StaticResource Caption}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="PublicAddressBox" AutomationProperties.Name="Endereço externo principal" MaxLength="253"/><Button Grid.Column="1" Content="Salvar" Click="SaveAddressClick" Margin="10,0,0,0"/><Button Grid.Column="2" Content="Copiar" Click="CopyPublicClick" Margin="10,0,0,0"/></Grid>
