                <Grid Grid.Row="0" ClipToBounds="True" SnapsToDevicePixels="True">
                  <Border Margin="1" Background="#151B12" ClipToBounds="True">
                  <Grid x:Name="BannerViewport" Background="{StaticResource LandscapeBrush}" ClipToBounds="True" SizeChanged="BannerViewportSizeChanged" SnapsToDevicePixels="True">
                    <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#B010150E" Offset="0"/><GradientStop Color="#9010150E" Offset="0.35"/><GradientStop Color="#1810150E" Offset="0.75"/><GradientStop Color="#0010150E" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                    <StackPanel x:Name="HeroContent" Margin="28,22,0,20" Width="420" HorizontalAlignment="Left" VerticalAlignment="Center">
                      <TextBlock x:Name="HeroEyebrow" Text="{loc:Translate Key=Text018}" FontFamily="Bahnschrift" FontSize="10" Foreground="#C8DBAC" Margin="0,0,0,10"/>
                      <TextBlock x:Name="HeroTitle" Style="{StaticResource BlockTitle}" FontSize="28" LineHeight="38"><Run Text="{loc:Translate Key=Text019}"/><LineBreak/><Run Text="{loc:Translate Key=Text020}"/></TextBlock>
                      <TextBlock x:Name="HeroCopy" Text="{loc:Translate Key=Text021}" FontSize="13" Foreground="#D5D8C6" Margin="0,12,0,0"/>
                    </StackPanel>
                  </Grid>
                  </Border>
                  <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" IsHitTestVisible="False" SnapsToDevicePixels="True"/>
