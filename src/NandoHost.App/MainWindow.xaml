<Window x:Class="NandoHost.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:NandoHost.App" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="NandoHost" Icon="Assets/Icons/nandohost-red.ico" Style="{StaticResource {x:Type Window}}" Width="1280" Height="920" MinWidth="960" MinHeight="640" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize">
  <Window.Resources>
    <Style x:Key="ChromeSurface" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SidebarSurface}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Visibility, ElementName=GameHome}" Value="Visible">
          <Setter Property="Background" Value="#0C1721"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border x:Name="WindowSurface" BorderThickness="0">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
      <Border x:Name="TitleSurface" Grid.Row="0" Style="{StaticResource ChromeSurface}" MouseLeftButtonDown="TitleDrag">
        <Grid Margin="18,0,4,0">
          <TextBlock Text="NandoHost" FontSize="10" Foreground="#B8B5A9" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource Flat}" Content="—" Click="MinimizeClick" Padding="14,7" Background="Transparent" Margin="0" ToolTip="{loc:Translate Key=Text001}"/>
            <Button Style="{StaticResource Flat}" x:Name="MaximizeButton" Content="□" Click="MaximizeClick" Padding="14,7" Background="Transparent" Margin="0" ToolTip="{loc:Translate Key=Text002}"/>
            <Button Style="{StaticResource Flat}" Content="✕" Click="CloseClick" Padding="14,7" Background="Transparent" Margin="0" ToolTip="{loc:Translate Key=Text003}"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1" x:Name="GameWorkspace" ClipToBounds="True">
        <Grid.RenderTransform><TranslateTransform x:Name="GameSlide"/></Grid.RenderTransform>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="228"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="GameSidebar" Background="{DynamicResource SidebarSurface}" BorderBrush="{DynamicResource SidebarBorder}" BorderThickness="0,0,1,0">
          <Grid x:Name="SidebarContent" Margin="20,28,20,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><Image x:Name="GameBrandIcon" Source="{StaticResource MinecraftGameImage}" Width="36" Height="36" Margin="0,0,8,0" ToolTip="Minecraft" AutomationProperties.Name="Minecraft"/><TextBlock Text="NandoHost" FontFamily="Bahnschrift" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" TextOptions.TextFormattingMode="Display"/></StackPanel>
              <Button Style="{StaticResource Flat}" Content="{loc:Translate Key=Text004}" Click="HomeClick" Background="Transparent" Foreground="{DynamicResource Muted}" FontSize="11" Padding="0,4" Margin="0,4,0,18" HorizontalAlignment="Left"/>
            </StackPanel>
            <StackPanel Grid.Row="1">
              <Button x:Name="DashboardNav" Style="{StaticResource Nav}" Content="{loc:Translate Key=Text005}" Tag="0" Click="NavigateClick" Background="#3F4933"/>
              <Button x:Name="PacksNav" Style="{StaticResource Nav}" Content="▦    Modpacks" Tag="1" Click="NavigateClick"/>
              <Button x:Name="NetworkNav" Style="{StaticResource Nav}" Content="{loc:Translate Key=Text006}" Tag="2" Click="NavigateClick"/>
              <Button x:Name="SettingsNav" Style="{StaticResource Nav}" Content="{loc:Translate Key=Text007}" Tag="3" Click="NavigateClick"/>
            </StackPanel>
            <StackPanel x:Name="ServerListHeading" Grid.Row="2" Margin="4,32,0,12">
              <TextBlock Text="{loc:Translate Key=Text008}" FontSize="10" Foreground="{DynamicResource Muted}"/>
              <TextBlock Text="{loc:Translate Key=Text009}" FontSize="10" Foreground="#938D7E" Margin="0,7,0,0"/>
            </StackPanel>
            <ListBox Grid.Row="3" x:Name="ServerList" Background="Transparent" BorderThickness="0" VerticalAlignment="Top" SelectionChanged="ServerSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Width="18" Height="20" VerticalAlignment="Top" Margin="0,2,7,0"><Image.Style><Style TargetType="Image"><Setter Property="Source" Value="{StaticResource MinecraftGameImage}"/><Style.Triggers><DataTrigger Binding="{Binding IsTerraria}" Value="True"><Setter Property="Source" Value="{StaticResource TerrariaGameImage}"/></DataTrigger></Style.Triggers></Style></Image.Style></Image><StackPanel Grid.Column="1"><TextBlock ToolTip="{Binding Name}" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"><Run Text="{Binding EditionLabel, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding MinecraftVersion}"/></TextBlock></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="4">
              <ComboBox x:Name="GameLanguageBox" Height="36" MinHeight="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,0,0,6" Padding="8,3" SelectedValuePath="Tag" SelectionChanged="LanguageSelectionChanged" AutomationProperties.Name="Idioma / Language" ToolTip="Idioma / Language"><ComboBoxItem Content="Português (Brasil)" Tag="pt-BR"/><ComboBoxItem Content="English" Tag="en-US"/></ComboBox>
              <Button x:Name="NewButton" Content="{loc:Translate Key=Text010}" Click="NewServerClick" Margin="0,12,0,18"/>
              <Border x:Name="SidebarNote" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" Background="{StaticResource DirtBrush}" Padding="12" RenderOptions.EdgeMode="Aliased"><StackPanel><TextBlock x:Name="SidebarNoteTitle" Text="{loc:Translate Key=Text011}" FontFamily="Bahnschrift" FontSize="10" Foreground="#D7D2BC"/><TextBlock Text="{loc:Translate Key=Text012}" FontSize="11" Foreground="#C2B8A4" Margin="0,7,0,0"/></StackPanel></Border>
              <TextBlock Text="{loc:Translate Key=Text013}" FontSize="9" Foreground="#938D7E" Margin="4,15,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border x:Name="GameTexture" Grid.Column="1" Background="{StaticResource DirtBrush}" Opacity="0.26" RenderOptions.EdgeMode="Aliased"/>
        <Grid x:Name="WorkspaceContent" Grid.Column="1" Margin="30,25,30,22">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid x:Name="PageHeader" Margin="0,0,0,20">
            <StackPanel><TextBlock x:Name="PageEyebrow" Text="{loc:Translate Key=Text014}" FontSize="10" Foreground="{DynamicResource Accent}"/><TextBlock x:Name="PageTitle" Text="{loc:Translate Key=Text015}" FontFamily="{StaticResource MinecraftFont}" FontSize="28" FontWeight="Bold" Margin="0,12,140,10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" TextOptions.TextFormattingMode="Display"/><TextBlock x:Name="PageSubtitle" Text="{loc:Translate Key=Text016}" Foreground="{DynamicResource Muted}" FontSize="12"/></StackPanel>
