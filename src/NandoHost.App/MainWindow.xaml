                    <ItemsControl x:Name="HomeServerShortcuts"><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource ServerShortcut}" Click="HomeServerClick" Tag="{Binding Id}" AutomationProperties.Name="{Binding Name}" Padding="12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontSize="13"/><TextBlock FontSize="10" Foreground="#91AAB9" Margin="0,6,0,0"><Run Text="{Binding EditionLabel, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding MinecraftVersion}"/></TextBlock></StackPanel><TextBlock Grid.Column="1" Text="→" Foreground="#E8BF80" Margin="10,0,0,0" VerticalAlignment="Center"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <TextBlock x:Name="HomeServersEmpty" Text="Nenhum servidor deste jogo. Use Abrir servidores para criar o primeiro." Foreground="#9DB4C2" FontSize="12" Visibility="Collapsed" Margin="0,4,0,10"/>
                    <TextBlock Text="Os mundos ficam neste computador." FontSize="10" Foreground="#718D9E" Margin="1,6,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.ColumnSpan="2" x:Name="HomeComingSoonPanel" Visibility="Collapsed"><TextBlock Text="Ainda não disponível"/></StackPanel>
            </Grid>
            <TextBlock Grid.Row="2" x:Name="HomeRunStatus" Text="Nenhum servidor em execução." Foreground="#718D9E" FontSize="11" Margin="0,22,0,0"/>
          </Grid>
        </ScrollViewer>
      </Grid>

      <Grid Grid.Row="1" x:Name="GameEntryOverlay" Panel.ZIndex="20" Background="#11150F" Visibility="Collapsed" Opacity="0" ClipToBounds="True" AutomationProperties.Name="Entrando no painel do Minecraft">
        <Border x:Name="GameEntryLandscape" Background="{StaticResource LandscapeBrush}" Opacity="0.24"/>
        <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#C0151913" Offset="0"/><GradientStop Color="#50151913" Offset="0.5"/><GradientStop Color="#E0151913" Offset="1"/></LinearGradientBrush></Border.Background></Border>
        <StackPanel x:Name="GameEntryContent" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
          <StackPanel.RenderTransform><ScaleTransform x:Name="GameEntryScale"/></StackPanel.RenderTransform>
          <Image x:Name="GameEntryImage" Source="{StaticResource MinecraftGameImage}" Width="88" Height="88" Margin="0,0,0,24"/>
          <TextBlock x:Name="GameEntryTitle" Text="Minecraft" FontFamily="{StaticResource MinecraftFont}" FontSize="44" FontWeight="Bold" Foreground="#F4F3E9" HorizontalAlignment="Center"/>
          <Border Width="40" Height="3" Background="{DynamicResource Accent}" HorizontalAlignment="Center" Margin="0,20,0,16"/>
          <TextBlock Text="PAINEL DO SERVIDOR" FontFamily="Bahnschrift" FontSize="11" Foreground="#BDCCAD" HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>
      <Border Grid.Row="2" Background="#202126" BorderBrush="{DynamicResource SidebarBorder}" BorderThickness="0,1,0,0"><Grid Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Pronto para criar seu primeiro servidor." Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><Button Style="{StaticResource Flat}" Grid.Column="1" x:Name="CancelButton" Content="Cancelar tarefa" Click="CancelClick" Visibility="Collapsed" Padding="10,3" Background="Transparent" FontSize="11" Margin="10,3"/><TextBlock Grid.Column="2" x:Name="AppMemoryText" Text="Painel nativo" FontSize="10" Foreground="#A2AB8B" VerticalAlignment="Center" Margin="16,0,0,0"/></Grid></Border>
    </Grid>
  </Border>
</Window>
