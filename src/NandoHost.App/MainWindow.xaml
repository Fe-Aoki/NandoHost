                    <TextBlock x:Name="HomeServersEmpty" Text="{loc:Translate Key=Text172}" Foreground="#9DB4C2" FontSize="12" Visibility="Collapsed" Margin="0,4,0,10"/>
                    <TextBlock Text="{loc:Translate Key=Text173}" FontSize="10" Foreground="#718D9E" Margin="1,6,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.ColumnSpan="2" x:Name="HomeComingSoonPanel" Visibility="Collapsed"><TextBlock Text="{loc:Translate Key=Text174}"/></StackPanel>
            </Grid>
            <TextBlock Grid.Row="2" x:Name="HomeRunStatus" Text="{loc:Translate Key=Text175}" Foreground="#718D9E" FontSize="11" Margin="0,22,0,0"/>
          </Grid>
        </ScrollViewer>
      </Grid>

      <Grid Grid.Row="1" x:Name="GameEntryOverlay" Panel.ZIndex="20" Background="#11150F" Visibility="Collapsed" Opacity="0" ClipToBounds="True" AutomationProperties.Name="{loc:Translate Key=Text176}">
        <Border x:Name="GameEntryLandscape" Background="{StaticResource LandscapeBrush}" Opacity="0.24"/>
        <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#C0151913" Offset="0"/><GradientStop Color="#50151913" Offset="0.5"/><GradientStop Color="#E0151913" Offset="1"/></LinearGradientBrush></Border.Background></Border>
        <StackPanel x:Name="GameEntryContent" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
          <StackPanel.RenderTransform><ScaleTransform x:Name="GameEntryScale"/></StackPanel.RenderTransform>
          <Image x:Name="GameEntryImage" Source="{StaticResource MinecraftGameImage}" Width="88" Height="88" Margin="0,0,0,24"/>
          <TextBlock x:Name="GameEntryTitle" Text="Minecraft" FontFamily="{StaticResource MinecraftFont}" FontSize="44" FontWeight="Bold" Foreground="#F4F3E9" HorizontalAlignment="Center"/>
          <Border Width="40" Height="3" Background="{DynamicResource Accent}" HorizontalAlignment="Center" Margin="0,20,0,16"/>
          <TextBlock Text="{loc:Translate Key=Text014}" FontFamily="Bahnschrift" FontSize="11" Foreground="#BDCCAD" HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>
      <Border x:Name="FooterSurface" Grid.Row="2" Style="{StaticResource ChromeSurface}" BorderBrush="{DynamicResource SidebarBorder}" BorderThickness="0,1,0,0"><Grid Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="{loc:Translate Key=Text177}" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><Button Style="{StaticResource Flat}" Grid.Column="1" x:Name="CancelButton" Content="{loc:Translate Key=Text178}" Click="CancelClick" Visibility="Collapsed" Padding="10,3" Background="Transparent" FontSize="11" Margin="10,3"/><TextBlock Grid.Column="2" x:Name="AppMemoryText" Text="{loc:Translate Key=Text179}" FontSize="10" Foreground="#A2AB8B" VerticalAlignment="Center" Margin="16,0,0,0"/></Grid></Border>
    </Grid>
  </Border>
</Window>
