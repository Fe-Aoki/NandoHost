<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AssemblyName>NandoHost</AssemblyName>
    <Version>0.9.0</Version>
    <ApplicationIcon>Assets/Icons/nandohost-red.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../NandoHost.Core/NandoHost.Core.csproj" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/Fonts/*.otf" /><Resource Include="Assets/Fonts/*.ttf" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/Images/*.png" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/Icons/*.ico" /></ItemGroup>
</Project>
